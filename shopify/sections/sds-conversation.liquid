{{ 'sds-conversation.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sds-conversation-preview.js' | asset_url }}" defer></script>
<script src="{{ 'sds-conversation-rating-preview.js' | asset_url }}" defer></script>
<section class="customer-conversation-body" aria-label="Vista de conversación de Soporte">
<div class="conversation-shell" aria-labelledby="conversationHeading">
    <header class="conversation-header">
      <a class="conversation-header__back" href="/pages/soporte" aria-label="Volver a Soporte">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
      </a>
      <div class="conversation-header__avatar" aria-hidden="true">
        <span class="sds-chat-monogram" aria-hidden="true">SDS</span>
      </div>
      <div class="conversation-header__copy">
        <h1 id="conversationHeading">Soporte | SANTA DEL SUR STORE</h1>
        <p id="conversationSubtitle">Consulta general</p>
      </div>
      <a class="conversation-header__close" href="/pages/soporte" aria-label="Cerrar vista y volver a Soporte">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
      </a>
    </header>

    <section id="conversationDemo" class="conversation-panel" aria-label="Vista previa de conversación" hidden>
      <div class="conversation-demo-notice" role="status">
        <span class="conversation-demo-notice__dot" aria-hidden="true"></span>
        Vista previa de diseño · mensajes ficticios · sin conexión con Soporte
      </div>
      <nav class="conversation-preview-switch" aria-label="Cambiar escenario de ejemplo">
        <a href="/pages/conversacion?demo=1" data-conversation-preview="general">General</a>
        <a href="/pages/conversacion?demo=buyer-pending" data-conversation-preview="buyer-pending">Sin verificar</a>
        <a href="/pages/conversacion?demo=buyer-verified" data-conversation-preview="buyer-verified">Pedido verificado</a>
        <a href="/pages/conversacion?demo=product" data-conversation-preview="product">Producto</a>
        <a href="/pages/conversacion?demo=closed-rating" data-conversation-preview="closed-rating">Calificación</a>
      </nav>
      <div class="conversation-context">
        <div class="conversation-context__row">
          <span id="conversationContextReason">Motivo: Cambios y devoluciones</span>
          <span id="conversationContextStatus" class="conversation-context__status">En proceso (ejemplo)</span>
        </div>
      </div>
      <section id="conversationBuyerPending" class="conversation-buyer-context conversation-buyer-context--pending" aria-label="Estado de verificación del pedido de ejemplo" hidden>
        <div class="conversation-buyer-context__intro">
          <span class="conversation-buyer-context__symbol" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 3 4 6v6c0 5 3.4 8 8 9 4.6-1 8-4 8-9V6l-8-3Z"/><path d="M12 8v5m0 3h.01"/></svg>
          </span>
          <div class="conversation-buyer-context__copy">
            <strong>Compra pendiente de verificación</strong>
            <p>No hay un pedido asociado de forma segura a esta conversación.</p>
          </div>
        </div>
      </section>
      <section id="conversationBuyerVerified" class="conversation-buyer-context conversation-buyer-context--verified" aria-label="Pedido asociado ficticio de demostración" hidden>
        <div class="conversation-buyer-context__intro">
          <span class="conversation-buyer-context__symbol" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
          </span>
          <div class="conversation-buyer-context__copy">
            <strong>Compra verificada (ejemplo)</strong>
            <p>Datos ficticios para revisar el diseño.</p>
          </div>
        </div>
        <div class="conversation-order-card" aria-label="Resumen de pedido de ejemplo">
          <div class="conversation-order-card__top">
            <span class="conversation-order-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M3 7 12 3l9 4v10l-9 4-9-4V7Z"/><path d="M3 7l9 4 9-4M12 11v10"/></svg>
            </span>
            <div class="conversation-order-card__identity">
              <strong>Pedido #SDS-DEMO</strong>
              <span>Pedido asociado · Ficticio</span>
            </div>
          </div>
          <div class="conversation-order-card__status">
            <span>Estado del pedido</span>
            <strong>En preparación (ejemplo)</strong>
          </div>
        </div>
      </section>
      <section id="conversationProductContext" class="conversation-product-context" aria-label="Contexto de producto de ejemplo" hidden>
        <p class="conversation-product-context__label">Estás consultando por este producto</p>
        <div class="conversation-product-card">
          {% if section.settings.demo_product_image != blank %}{{ section.settings.demo_product_image | image_url: width: 160 | image_tag: class: "conversation-product-card__image", loading: "lazy" }}{% endif %}
          <div class="conversation-product-card__copy">
            <strong>Proyector de formas navideñas portable</strong>
            <span>Producto consultado · Ejemplo</span>
            <small>La oferta seleccionada se mostrará cuando exista un contexto comercial autorizado.</small>
          </div>
        </div>
      </section>
      <div id="conversationMessagesDemo" class="conversation-messages" role="log" aria-label="Mensajes de ejemplo">
        <p class="conversation-day">Hoy · Conversación de ejemplo</p>
        <article class="conversation-message conversation-message--customer">
          <div class="conversation-message__bubble">
            <p id="conversationSampleCustomer">Hola, quería consultar sobre las opciones de devolución.</p>
            <span>Vos · 10:32</span>
          </div>
        </article>
        <article class="conversation-message conversation-message--support">
          <span class="conversation-message__avatar" aria-hidden="true">
            <span class="sds-chat-monogram" aria-hidden="true">SDS</span>
          </span>
          <div class="conversation-message__bubble">
            <p id="conversationSampleSupport">¡Hola! Recibimos tu consulta. Vamos a ayudarte con la información correspondiente.</p>
            <span>Soporte · 10:35</span>
          </div>
        </article>
        <p class="conversation-privacy">Los mensajes reales serán privados de cada conversación autorizada.</p>
      </div>
      <div id="conversationClosedNotice" class="conversation-closed-notice" role="status" hidden>
        <span class="conversation-closed-notice__mark" aria-hidden="true">✓</span>
        <div class="conversation-closed-notice__copy">
          <strong>Conversación finalizada</strong>
          <span>Ya no es posible responder en este chat.</span>
        </div>
        <button id="conversationReopenRating" type="button" class="conversation-closed-notice__rate">Calificar atención</button>
      </div>
      <div id="conversationComposerPreview" class="conversation-composer" aria-label="Redacción de mensajes: no disponible en demostración">
        <div class="conversation-composer__bar">
          <button type="button" disabled aria-label="Adjuntar archivo, no habilitado" title="Adjuntos disponibles tras activar Soporte">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m19 13-7.6 7.6a5 5 0 0 1-7-7L13 4.9a3.4 3.4 0 0 1 4.8 4.8l-8.5 8.5a1.7 1.7 0 0 1-2.4-2.4L14.5 8" /></svg>
          </button>
          <textarea rows="1" disabled aria-label="Escribir mensaje, no habilitado" placeholder="Escribí tu mensaje..."></textarea>
          <button type="button" class="conversation-composer__send" disabled aria-label="Enviar mensaje, no habilitado" title="Envío disponible al conectar Protocol Data">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z" /><path d="M22 2 11 13" /></svg>
          </button>
        </div>
        <p>Vista previa: no podés enviar mensajes desde esta pantalla.</p>
      </div>
    </section>

    <!-- Case A/B/C shared CSAT presentation fixture; no real feedback endpoint. -->
    <div id="conversationRatingBackdrop" class="conversation-rating-backdrop" hidden>
      <section id="conversationRatingSheet" class="conversation-rating-sheet" role="dialog" aria-modal="true" aria-labelledby="conversationRatingTitle" aria-describedby="conversationRatingQuestion" tabindex="-1">
        <div class="conversation-rating-handle" aria-hidden="true"></div>
        <button id="conversationRatingClose" class="conversation-rating-close" type="button" aria-label="Cerrar calificación">×</button>
        <div id="conversationRatingFormView" class="conversation-rating-view">
          <div class="conversation-rating-success-mark" aria-hidden="true">✓</div>
          <h2 id="conversationRatingTitle">Tu conversación finalizó</h2>
          <p id="conversationRatingQuestion" class="conversation-rating-question">¿Cómo calificarías la atención recibida?</p>
          <form id="conversationRatingForm" novalidate>
            <fieldset class="conversation-rating-fieldset">
              <legend class="visually-hidden">Seleccioná de una a cinco estrellas</legend>
              <div class="conversation-rating-stars" role="radiogroup" aria-label="Calificación de la atención">
                <button type="button" class="conversation-rating-star" data-rating-score="1" role="radio" aria-checked="false" aria-label="1 estrella · Muy mala">★</button>
                <button type="button" class="conversation-rating-star" data-rating-score="2" role="radio" aria-checked="false" aria-label="2 estrellas · Mala">★</button>
                <button type="button" class="conversation-rating-star" data-rating-score="3" role="radio" aria-checked="false" aria-label="3 estrellas · Regular">★</button>
                <button type="button" class="conversation-rating-star" data-rating-score="4" role="radio" aria-checked="false" aria-label="4 estrellas · Buena">★</button>
                <button type="button" class="conversation-rating-star" data-rating-score="5" role="radio" aria-checked="false" aria-label="5 estrellas · Excelente">★</button>
              </div>
            </fieldset>
            <p id="conversationRatingSelection" class="conversation-rating-selection" aria-live="polite">Seleccioná de 1 a 5 estrellas</p>
            <label class="conversation-rating-label" for="conversationRatingComment">¿Querés contarnos algo más?</label>
            <textarea id="conversationRatingComment" class="conversation-rating-comment" rows="3" maxlength="600" placeholder="Escribí tu opinión (opcional)"></textarea>
            <p class="conversation-rating-helper">Tu opinión nos ayuda a mejorar nuestro servicio.</p>
            <button id="conversationRatingSubmit" class="conversation-rating-submit" type="submit" disabled>Simular envío de calificación</button>
            <button id="conversationRatingSkip" class="conversation-rating-skip" type="button">Ahora no</button>
          </form>
          <p class="conversation-rating-disclosure">Demostración visual: no se envían ni almacenan calificaciones reales. Esta encuesta evalúa la atención, no el producto.</p>
        </div>
        <div id="conversationRatingFinished" class="conversation-rating-finished" hidden>
          <div class="conversation-rating-success-mark" aria-hidden="true">✓</div>
          <h2>Gracias por tu opinión</h2>
          <p>Esta es una confirmación de ejemplo. Tu calificación no se envió ni quedó registrada.</p>
          <button id="conversationRatingDone" class="conversation-rating-submit" type="button">Volver a la conversación</button>
        </div>
      </section>
    </div>

    <section id="conversationEmpty" class="conversation-empty" aria-labelledby="conversationEmptyTitle">
      <div class="conversation-empty__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4v8Z" /></svg>
      </div>
      <h2 id="conversationEmptyTitle">No hay una conversación activa</h2>
      <p>La continuidad segura por correo todavía no está conectada a Protocol Data. Esta página no busca casos por correo ni muestra conversaciones sin autorización.</p>
      <a class="conversation-empty__return" href="/pages/soporte">Volver a Soporte</a>
      <a class="conversation-empty__preview" href="/pages/conversacion?demo=1">Ver una conversación de ejemplo</a>
      <a class="conversation-empty__preview" href="/pages/conversacion?demo=buyer-pending">Ver consulta de pedido de ejemplo</a>
      <a class="conversation-empty__preview" href="/pages/conversacion?demo=product">Ver consulta de producto de ejemplo</a>
      <a class="conversation-empty__preview" href="/pages/conversacion?demo=closed-rating">Ver cierre y calificación de ejemplo</a>
    </section>
  </div>

</section>
{% schema %}
{"name":"SDS · Conversaciones","tag":"section","settings":[{"type":"image_picker","id":"demo_product_image","label":"Imagen para demostración ficticia"}],"presets":[{"name":"SDS · Conversaciones"}]}
{% endschema %}