{% comment %}
  SANTA CLAUSULA / SHOPIFY COLLECTION TEMPLATE BLUEPRINT (NOT INSTALLED)
  One section for all collections; no manual page per collection.
  Port to active theme sections/santa-clausula-collection.liquid and
  templates/collection.json when Shopify is authorized.
  Collection.title, collection.image, collection.description and
  collection.products are Shopify's commerce authority.
{% endcomment %}
{% liquid
  assign sc_hero = collection.image
  if sc_hero == blank
    assign sc_hero = section.settings.default_banner
  endif
%}
<div class="sc-native-collection">
  <div class="sc-native-collection__hero" aria-label="{{ collection.title | escape }}">
    {% if sc_hero != blank %}
      {{ sc_hero | image_url: width: 2400 | image_tag: class: 'sc-native-collection__hero-image', loading: 'eager', fetchpriority: 'high' }}
    {% else %}
      <div class="sc-native-collection__hero-fallback" aria-hidden="true"></div>
    {% endif %}
  </div>

  <div class="sc-native-collection__content">
    <nav class="sc-native-collection__breadcrumb" aria-label="Ruta de navegación">
      <a href="{{ routes.root_url }}">Inicio</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ collection.title | escape }}</span>
    </nav>

    <header class="sc-native-collection__intro">
      <p class="sc-native-collection__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1>{{ collection.title | escape }}</h1>
      {% if collection.description != blank %}
        <div class="sc-native-collection__description">{{ collection.description }}</div>
      {% endif %}
    </header>

    {% paginate collection.products by 24 %}
      <div class="sc-native-collection__toolbar">
        <div>
          <h2>Descubrí la colección</h2>
          <p>{{ collection.products_count }} productos</p>
        </div>
        <form method="get" class="sc-native-collection__sort">
          <label for="sc-collection-sort">Ordenar por</label>
          {% assign current_sort = collection.sort_by | default: collection.default_sort_by %}
          <select name="sort_by" id="sc-collection-sort">
            {% for option in collection.sort_options %}
              <option value="{{ option.value | escape }}"{% if option.value == current_sort %} selected{% endif %}>{{ option.name | escape }}</option>
            {% endfor %}
          </select>
          <button type="submit">Aplicar</button>
        </form>
      </div>

      <div class="sc-native-collection__grid">
        {% for product in collection.products %}
          <article class="sc-native-collection__card">
            <a href="{{ product.url }}" class="sc-native-collection__product-link">
              <div class="sc-native-collection__media">
                {% if product.featured_image != blank %}
                  {{ product.featured_image | image_url: width: 720 | image_tag: loading: 'lazy', class: 'sc-native-collection__product-image' }}
                {% endif %}
              </div>
              <div class="sc-native-collection__details">
                <h3>{{ product.title | escape }}</h3>
                <strong>{{ product.price | money }}</strong>
              </div>
            </a>
          </article>
        {% else %}
          <p>Por ahora no hay productos disponibles en esta colección.</p>
        {% endfor %}
      </div>
      <div class="sc-native-collection__pagination">{{ paginate | default_pagination }}</div>
    {% endpaginate %}

    {% if section.settings.collections_menu != blank %}
      <nav class="sc-native-collection__other" aria-label="Otras colecciones">
        <h2>Explorá otras colecciones</h2>
        <div class="sc-native-collection__other-links">
          {% for link in section.settings.collections_menu.links %}
            <a href="{{ link.url }}">{{ link.title | escape }}</a>
          {% endfor %}
        </div>
      </nav>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  body:has(.sc-native-collection) { background: #EDEDED; }
  .sc-native-collection { min-height: 100vh; background: #EDEDED; color: #1E1E1E; }
  .sc-native-collection *, .sc-native-collection *::before, .sc-native-collection *::after { box-sizing: border-box; }
  .sc-native-collection__hero { position: relative; width: 100%; height: 25svh; overflow: hidden; background: #19452A; }
  .sc-native-collection__hero-image { display: block; width: 100%; height: 100%; object-fit: cover; }
  .sc-native-collection__hero-fallback { width: 100%; height: 100%; background: linear-gradient(130deg,#0E502D,#9B1222); }
  .sc-native-collection__content { max-width: 1180px; margin: 0 auto; padding: 24px 22px 70px; }
  .sc-native-collection__breadcrumb { display: flex; gap: 10px; color: #777; font-size: 12px; }
  .sc-native-collection__breadcrumb a { color: #555; text-decoration: none; }
  .sc-native-collection__intro { margin: 23px 0 34px; }
  .sc-native-collection__eyebrow { color: #1E7437; font-size: 10px; font-weight: 800; letter-spacing: .09em; text-transform: uppercase; }
  .sc-native-collection__intro h1 { margin: 7px 0 10px; font-size: clamp(29px,4vw,44px); line-height: 1.2; letter-spacing: -.035em; }
  .sc-native-collection__description { max-width: 700px; color: #686868; font-size: 13px; line-height: 1.7; }
  .sc-native-collection__toolbar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 16px; margin-bottom: 18px; }
  .sc-native-collection__toolbar h2, .sc-native-collection__other h2 { margin: 0; font-size: 21px; }
  .sc-native-collection__toolbar p { color: #777; font-size: 11px; }
  .sc-native-collection__sort { display: flex; align-items: center; gap: 9px; color: #777; font-size: 11px; }
  .sc-native-collection__sort select, .sc-native-collection__sort button { min-height: 39px; padding: 8px 10px; border: 0; border-radius: 4px; background: #FFF; color: #333; box-shadow: 0 1px 3px rgba(24,35,27,.12); }
  .sc-native-collection__grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 16px; }
  .sc-native-collection__card { min-width: 0; overflow: hidden; background: #FFF; border: 0; border-radius: 4px; box-shadow: 0 1px 3px rgba(24,35,27,.12); }
  .sc-native-collection__product-link { color: inherit; text-decoration: none; }
  .sc-native-collection__media { width: 100%; aspect-ratio: 4/5; background: #F9F9F9; }
  .sc-native-collection__product-image { display: block; width: 100%; height: 100%; object-fit: contain; }
  .sc-native-collection__details { display: flex; flex-direction: column; gap: 8px; padding: 13px; }
  .sc-native-collection__details h3 { margin: 0; font-size: 13px; line-height: 1.45; }
  .sc-native-collection__details strong { color: #1E7437; font-size: 15px; }
  .sc-native-collection__pagination { margin-top: 26px; }
  .sc-native-collection__other { margin-top: 40px; }
  .sc-native-collection__other-links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 14px; }
  .sc-native-collection__other-links a { padding: 10px 14px; background: #FFF; border-radius: 4px; box-shadow: 0 1px 3px rgba(24,35,27,.12); text-decoration: none; color: #1E7437; font-size: 12px; font-weight: 700; }
  @media (max-width:900px) { .sc-native-collection__grid { grid-template-columns: repeat(3,minmax(0,1fr)); } }
  @media (max-width:640px) {
    .sc-native-collection__content { padding: 18px 13px 90px; }
    .sc-native-collection__intro { margin: 20px 0 26px; }
    .sc-native-collection__grid { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 11px; }
    .sc-native-collection__toolbar h2 { font-size: 18px; }
    .sc-native-collection__sort { flex-wrap: wrap; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Colección Santa Clausula",
  "settings": [
    {
      "type": "image_picker",
      "id": "default_banner",
      "label": "Imagen navideña por defecto"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Encabezado pequeño",
      "default": "COLECCIÓN DE TEMPORADA"
    },
    {
      "type": "link_list",
      "id": "collections_menu",
      "label": "Menú de colecciones"
    }
  ]
}
{% endschema %}
